# Optional. The local MVP runs without cloud credentials.
# SQLite database file used by the local MVP.
RELEASEGUARD_DB_PATH=releaseguard.db
RELEASEGUARD_RISK_THRESHOLD_HIGH=70
RELEASEGUARD_RISK_THRESHOLD_MEDIUM=40

# Optional. Fine-grained token restricted to target repository, Pull requests: read-only.
# Add Actions: read to retrieve GitHub Actions test artifacts.
# Never commit a real token.
GITHUB_TOKEN=

# Optional Microsoft Agent Framework + Azure OpenAI specialist agents.
# Leave provider=local for the credential-free deterministic MVP.
RELEASEGUARD_AI_PROVIDER=local
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Azure deployment name (not just the model family name).
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional RAG policy retrieval. Requires Azure AI Search + an Azure OpenAI embedding deployment.
RELEASEGUARD_RAG_ENABLED=false
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=releaseguard-policies
AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
